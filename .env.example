# Copy this file to `.env` and fill in the values.
# NEVER commit the real `.env` — it is gitignored.

# --- Testnet deployment (Sepolia) -------------------------------------------
# Private key of a wallet funded with a little SepoliaETH (faucet: sepoliafaucet.com)
# NEVER use a mainnet key. Format: 0x + 64 hex chars.
PRIVATE_KEY=

# Any Sepolia RPC. Public endpoint works fine for demos:
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Free Etherscan API key (https://etherscan.io/register) — used for contract verification.
ETHERSCAN_API_KEY=

# --- Python CLI ---------------------------------------------------------------
# Network the CLI talks to. Defaults to http://127.0.0.1:8545 (local anvil).
MODEL_LEDGER_RPC_URL=

# Deployed contract address shown to the CLI when you do not want
# it to read deployments/<network>.json. Overrides auto-discovery.
MODEL_LEDGER_CONTRACT=

# Private key used by the CLI for submitting transactions (register/update/transfer).
MODEL_LEDGER_PRIVATE_KEY=